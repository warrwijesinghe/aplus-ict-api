# Application
NODE_ENV=development
PORT=4000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aplus_ict
DB_USER=aplus_ict
DB_PASSWORD=change-me

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
WEB_LOGIN_SUCCESS_URL=http://localhost:5173/login/success

# Cross-origin requests
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Upload storage
UPLOAD_ROOT=storage/uploads
PUBLIC_UPLOAD_DIR=storage/uploads/public
PRIVATE_UPLOAD_DIR=storage/uploads/private
PUBLIC_UPLOAD_URL=/uploads
SERVE_PUBLIC_UPLOADS=true

# Upload limits
MAX_IMAGE_UPLOAD_MB=10
MAX_DOCUMENT_UPLOAD_MB=25
MAX_PAYMENT_SLIP_UPLOAD_MB=10

# DirectPay - one-time card payments (development)
DIRECTPAY_ENABLED=false
DIRECTPAY_ENVIRONMENT=development
DIRECTPAY_MERCHANT_ID=LM13479
DIRECTPAY_MERCHANT_SECRET=

# Resource management and retention
RESOURCE_MAX_UPLOAD_MB=25
RESOURCE_TEMP_DIR=storage/tmp
RESOURCE_PUBLIC_DIR=storage/uploads/public
RESOURCE_PRIVATE_DIR=storage/uploads/private
RESOURCE_ARCHIVE_RETENTION_DAYS=90
PAYMENT_SLIP_RETENTION_DAYS=2555
ASSIGNMENT_SUBMISSION_RETENTION_DAYS=730
